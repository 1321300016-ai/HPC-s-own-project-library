# ================================================================
# 路由器项目 Makefile
# 功能：编译所有源文件，生成 router 可执行文件
# 用法：
#   make          - 编译
#   make clean    - 清理
#   make debug    - 编译（带调试信息）
# ================================================================

# ==================== 编译器设置 ====================
CC = gcc
CFLAGS = -Wall -O2 -g
LDFLAGS = -lpthread

# ==================== 目标文件 ====================
TARGET = router

# ==================== 源文件列表 ====================
# ★★★ 业务代码（你自己写的） ★★★
SRCS = main.c \
       key_pthread.c \
       ip_filter.c \
       arp_cache.c \
       ip_pthread.c 

# ★★★ 通用工具库（复制来的，不用改） ★★★
SRCS += simple_list.c \
        cmd_parser.c \
        net_iface.c \
        logger.c \
        static_pool.c

# ==================== 自动生成 .o 文件列表 ====================
OBJS = $(SRCS:.c=.o)

# ==================== 默认目标 ====================
all: $(TARGET)

# ==================== 链接 ====================
$(TARGET): $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)
	@echo "=========================================="
	@echo "编译成功！运行: sudo ./$(TARGET)"
	@echo "=========================================="

# ==================== 编译规则 ====================
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# ==================== 调试版本 ====================
debug: CFLAGS += -DDEBUG -g
debug: clean all

# ==================== 清理 ====================
clean:
	rm -f $(OBJS) $(TARGET)
	@echo "清理完成"

# ==================== 伪目标 ====================
.PHONY: all clean debug